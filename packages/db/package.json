{
  "name": "@bloodline/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations and seed for BloodLine BBMS",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(no lint configured for db)\"",
    "test": "echo \"(no tests in db)\"",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "push": "prisma db push --skip-generate",
    "studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "format": "prisma format",
    "validate": "prisma validate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3"
  }
}
